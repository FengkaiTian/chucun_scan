    },
    {
      "id": "computational_scientist",
      "label": "Computational Scientist",
      "generic": false,
      "patterns": [
        "\\bcomputational\\s+scientist\\b",
        "\\bscientific\\s+(software|computing)\\s+(engineer|specialist)\\b"
      ]
    },
    {
      "id": "research_engineer",
      "label": "Research Engineer",
      "generic": false,
      "patterns": [
        "\\bresearch\\s+engineer\\b",
        "\\bresearch\\s+&?\\s*development\\s+engineer\\b"
      ]
    },
    {
      "id": "research_specialist",
      "label": "Research Specialist",
      "generic": true,
      "patterns": [
        "\\bresearch\\s+special(ist)?\\b",
        "\\bresearch\\s+technician\\b"
      ]
    },
    {
      "id": "research_program_manager",
      "label": "Research Program Manager",
      "generic": false,
      "patterns": [
        "\\bresearch\\s+program\\s+(manager|coordinator|director)\\b",
        "\\bprogram\\s+manager\\b[^,;]{0,20}\\bresearch\\b"
      ]
    },
    {
      "id": "phenotyping_facility_manager",
      "label": "Phenotyping Facility Manager",
      "generic": false,
      "patterns": [
        "\\bphenotyp(ing|e)\\b[^,;]{0,30}\\b(facility|platform|center|centre)\\b[^,;]{0,20}\\b(manager|director|lead)\\b",
        "\\b(manager|director|lead)\\b[^,;]{0,30}\\bphenotyp(ing|e)\\s+(facility|platform)\\b"
      ]
    },
    {
      "id": "core_facility_manager",
      "label": "Core Facility Manager",
      "generic": false,
      "patterns": [
        "\\bcore\\s+facility\\s+(manager|director|lead)\\b",
        "\\b(manager|director)\\b[^,;]{0,20}\\bcore\\s+facility\\b"
      ]
    },
    {
      "id": "field_research_manager",
      "label": "Field Research Manager",
      "generic": false,
      "patterns": [
        "\\bfield\\s+research\\s+(manager|supervisor|coordinator|director)\\b",
        "\\bresearch\\s+farm\\s+(manager|supervisor)\\b",
        "\\bfield\\s+(operations|trial(s)?)\\s+manager\\b"
      ]
    },
    {
      "id": "uas_program_manager",
      "label": "UAS Program Manager",
      "generic": false,
      "patterns": [
        "\\b(uas|uav|drone|unmanned\\s+air(craft|ial))\\b[^,;]{0,30}\\b(program|operations|flight)\\b[^,;]{0,20}\\b(manager|coordinator|director|lead)\\b",
        "\\b(manager|coordinator|director)\\b[^,;]{0,25}\\b(uas|uav|drone)\\s+(program|operations)\\b",
        "\\b(chief|lead)\\s+(uas|uav|drone)\\s+pilot\\b"
      ]
    },
    {
      "id": "laboratory_manager",
      "label": "Laboratory Manager",
      "generic": true,
      "patterns": [
        "\\blab(oratory)?\\s+(manager|supervisor|coordinator)\\b",
