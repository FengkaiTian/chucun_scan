{
  "_comment": "职位名称匹配规则。categories 按顺序匹配，先匹配到的胜出，所以更具体的必须排在更宽泛的前面（例如 Research Assistant Professor 必须在 Assistant Professor 之前）。patterns 为不区分大小写的正则。",

  "settings": {
    "fuzzy_threshold": 88,
    "require_domain_for_generic": true,
    "_require_domain_note": "对 generic=true 的宽泛职位（Lecturer / Instructor / Research Associate 等），要求标题或描述里至少命中一个领域关键词，否则丢弃。关掉它会捞进大量护理、临床、音乐类岗位。设为 false 可完全关闭。"
  },

  "categories": [
    {
      "id": "presidential_provost_postdoc_fellow",
      "label": "Presidential / Provost Postdoctoral Fellow",
      "generic": false,
      "patterns": [
        "\\b(presidential|provost'?s?|chancellor'?s?|dean'?s?|distinguished|prestigious)\\b[^,;]{0,40}\\bpost[\\s\\-–]?doc(toral)?\\b[^,;]{0,20}\\bfellow"
      ]
    },
    {
      "id": "assistant_professor_and_extension_specialist",
      "label": "Assistant Professor and Extension Specialist",
      "generic": false,
      "patterns": [
        "\\bassist(ant|\\.)?\\s+prof(essor|\\.)?\\b[^,;]{0,30}\\bextension\\s+special(ist)?",
        "\\bextension\\s+special(ist)?\\b[^,;]{0,30}\\bassist(ant|\\.)?\\s+prof(essor|\\.)?"
      ]
    },
    {
      "id": "extension_assistant_professor",
      "label": "Extension Assistant Professor",
      "generic": false,
      "patterns": ["\\bextension\\s+assist(ant|\\.)?\\s+prof(essor|\\.)?\\b"]
    },
    {
      "id": "research_assistant_professor",
      "label": "Research Assistant Professor",
      "generic": false,
      "patterns": ["\\bresearch\\s+assist(ant|\\.)?\\s+prof(essor|\\.)?\\b"]
    },
    {
      "id": "assistant_research_professor",
      "label": "Assistant Research Professor",
      "generic": false,
      "patterns": ["\\bassist(ant|\\.)?\\s+research\\s+prof(essor|\\.)?\\b"]
    },
    {
      "id": "teaching_assistant_professor",
      "label": "Teaching Assistant Professor",
      "generic": false,
      "patterns": [
        "\\bteaching\\s+assist(ant|\\.)?\\s+prof(essor|\\.)?\\b",
        "\\bassist(ant|\\.)?\\s+teaching\\s+prof(essor|\\.)?\\b"
      ]
    },
    {
      "id": "assistant_associate_professor",
      "label": "Assistant/Associate Professor",
      "generic": false,
      "patterns": [
        "\\bassist(ant|\\.)?\\s*(?:/|,|\\s+or\\s+|\\s+and\\s+|&|\\s+-\\s+)\\s*assoc(iate|\\.)?\\s+prof(essor|\\.)?\\b",
        "\\bassoc(iate|\\.)?\\s*(?:/|,|\\s+or\\s+|\\s+and\\s+|&|\\s+-\\s+)\\s*assist(ant|\\.)?\\s+prof(essor|\\.)?\\b",
        "\\bassist(ant|\\.)?\\s*,?\\s*assoc(iate|\\.)?\\s*,?\\s*or\\s+full\\s+prof(essor|\\.)?\\b"
      ]
    },
    {
      "id": "assistant_professor",
      "label": "Assistant Professor",
      "generic": false,
      "patterns": [
        "\\bassist(ant|\\.)?\\s+prof(essor|\\.)?\\b",
        "\\basst\\.?\\s+prof(essor|\\.)?\\b",
        "\\btenure[\\s\\-]track\\s+(faculty|position)\\b"
      ]
    },
    {
      "id": "postdoctoral_research_associate",
      "label": "Postdoctoral Research Associate",
      "generic": false,
      "patterns": ["\\bpost[\\s\\-–]?doc(toral)?\\s+research\\s+assoc(iate|\\.)?\\b"]
    },
    {
      "id": "postdoctoral_researcher",
      "label": "Postdoctoral Researcher",
      "generic": false,
      "patterns": [
        "\\bpost[\\s\\-–]?doc(toral)?\\s+research(er)?\\b",
        "\\bpost[\\s\\-–]?doc(toral)?\\s+position\\b"
      ]
    },
    {
      "id": "postdoctoral_fellow",
      "label": "Postdoctoral Fellow",
      "generic": false,
      "patterns": [
        "\\bpost[\\s\\-–]?doc(toral)?\\s+fellow(ship)?\\b",
        "\\bpost[\\s\\-–]?doc(toral)?\\s+research\\s+fellow\\b"
      ]
    },
    {
      "id": "postdoctoral_scholar",
      "label": "Postdoctoral Scholar",
      "generic": false,
      "patterns": ["\\bpost[\\s\\-–]?doc(toral)?\\s+scholar\\b"]
    },
    {
      "id": "postdoctoral_other",
      "label": "Postdoctoral (其他表述)",
      "generic": false,
      "patterns": [
        "\\bpost[\\s\\-–]?doc(toral)?\\s+(associate|trainee|appointment|opportunity)\\b",
        "^\\s*post[\\s\\-–]?doc(toral)?\\b",
        "\\bpostdoc\\b"
      ]
    },
    {
      "id": "senior_research_associate",
      "label": "Senior Research Associate",
      "generic": false,
      "patterns": ["\\b(senior|sr\\.?|lead|principal)\\s+research\\s+assoc(iate|\\.)?\\b"]
    },
    {
      "id": "research_associate",
      "label": "Research Associate",
      "generic": true,
      "patterns": ["\\bresearch\\s+assoc(iate|\\.)?\\b"]
    },
    {
      "id": "extension_associate",
      "label": "Extension Associate",
      "generic": false,
      "patterns": ["\\bextension\\s+assoc(iate|\\.)?\\b"]
    },
    {
      "id": "extension_specialist",
      "label": "Extension Specialist",
      "generic": false,
      "patterns": [
        "\\bextension\\s+special(ist)?\\b",
        "\\bextension\\s+educator\\b",
        "\\bstate\\s+extension\\s+(specialist|agent)\\b"
      ]
    },
    {
      "id": "research_data_scientist",
      "label": "Research Data Scientist",
      "generic": false,
      "patterns": [
        "\\bresearch\\s+data\\s+scientist\\b",
        "\\bdata\\s+scientist\\b[^,;]{0,20}\\bresearch\\b"
      ]
    },
    {
      "id": "research_scientist",
      "label": "Research Scientist",
      "generic": false,
      "patterns": [
        "\\bresearch\\s+scientist\\b",
        "\\b(senior|sr\\.?|principal|lead)\\s+research\\s+scientist\\b"
      ]
    },
    {
      "id": "assistant_scientist",
      "label": "Assistant Scientist",
      "generic": false,
      "patterns": ["\\bassist(ant|\\.)?\\s+scientist\\b"]
    },
    {
      "id": "associate_scientist",
      "label": "Associate Scientist",
      "generic": false,
      "patterns": ["\\bassoc(iate|\\.)?\\s+scientist\\b"]
    },
    {
      "id": "staff_scientist",
      "label": "Staff Scientist",
      "generic": false,
