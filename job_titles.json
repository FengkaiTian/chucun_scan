  "citizenship_patterns": [
    "u\\.?s\\.?\\s+citizen(ship)?\\s+(is\\s+)?(required|only)",
    "must\\s+be\\s+a\\s+u\\.?s\\.?\\s+citizen",
    "open\\s+to\\s+u\\.?s\\.?\\s+citizens\\s+only",
    "restricted\\s+to\\s+u\\.?s\\.?\\s+citizens",
    "united\\s+states\\s+citizenship\\s+(is\\s+)?required",
    "canadian\\s+citizens?\\s+(and|or)\\s+permanent\\s+residents?\\s+(will\\s+be\\s+)?(given\\s+)?priorit",
    "security\\s+clearance\\s+(is\\s+)?required"
  ],

  "sponsorship_patterns": [
    "visa\\s+sponsorship\\s+(is\\s+)?(available|provided|offered)",
    "will\\s+sponsor",
    "we\\s+sponsor\\s+(h-?1b|work\\s+visas?)",
    "eligible\\s+for\\s+visa\\s+sponsorship",
    "h-?1b\\s+sponsorship"
  ],

  "deadline_patterns": [
    "(?:application(?:s)?\\s+(?:due|deadline|close[sd]?)|deadline\\s+(?:for\\s+application(?:s)?\\s+)?(?:is|:)?|closing\\s+date\\s*:?|apply\\s+by|must\\s+be\\s+received\\s+by)\\s*(?:on\\s+)?([A-Z][a-z]+\\.?\\s+\\d{1,2},?\\s+\\d{4})",
    "(?:application(?:s)?\\s+(?:due|deadline|close[sd]?)|closing\\s+date\\s*:?|apply\\s+by)\\s*(?:on\\s+)?(\\d{1,2}\\s+[A-Z][a-z]+\\s+\\d{4})",
    "(?:application(?:s)?\\s+(?:due|deadline|close[sd]?)|closing\\s+date\\s*:?|apply\\s+by)\\s*(?:on\\s+)?(\\d{4}-\\d{2}-\\d{2})",
    "(?:review\\s+of\\s+application(?:s)?\\s+(?:will\\s+)?begin(?:s|ning)?)\\s*(?:on\\s+)?([A-Z][a-z]+\\.?\\s+\\d{1,2},?\\s+\\d{4})",
    "(open\\s+until\\s+filled)",
    "(until\\s+(?:the\\s+)?position\\s+is\\s+filled)",
    "(rolling\\s+basis)"
  ]
