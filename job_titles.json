      ]
    },
    {
      "id": "research_fellow",
      "label": "Research Fellow",
      "generic": true,
      "patterns": ["\\bresearch\\s+fellow(ship)?\\b"]
    },
    {
      "id": "lecturer",
      "label": "Lecturer",
      "generic": true,
      "patterns": [
        "\\blecturer\\b",
        "\\b(teaching|assistant\\s+teaching)\\s+fellow\\b"
      ]
    },
    {
      "id": "instructor",
      "label": "Instructor",
      "generic": true,
      "patterns": ["\\binstructor\\b"]
    }
  ],

